.share-btns svg { width: 14px; height: 14px; fill: currentcolor; }

footer { position: relative; z-index: 2; text-align: center; padding: 50px 20px 40px; color: var(--ink-dim); font-size: 0.9rem; border-top: 1px solid rgba(155, 108, 255, 0.15); margin-top: 40px; background: linear-gradient(transparent, rgba(155, 108, 255, 0.05)); }

footer .sig { font-family: Cinzel, serif; letter-spacing: 0.4em; font-size: 0.7rem; color: var(--gold); text-transform: uppercase; margin-bottom: 10px; }

footer .wall { margin-top: 20px; font-family: "Cormorant Garamond", serif; font-style: italic; color: var(--violet); opacity: 0.7; }

.reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.9s, transform 0.9s; }

.reveal.in { opacity: 1; transform: translateY(0px); }

@media (max-width: 640px) {
  header { padding: 80px 20px 60px; }
  .container { padding: 40px 22px; margin: 0px 12px 40px; border-radius: 14px; }
  p { text-align: left; }
  .destaque { padding: 22px 22px 22px 50px; font-size: 1.15rem; }
}
